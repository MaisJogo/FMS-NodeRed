        "ui": "f26cc9bff8326cdd",
        "name": "Formatação do Header",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "/* Cria o logotipo do SENAI dinamicamente dentro da barra de título */\n.v-toolbar__content::after {\n    content: \"\";\n    display: block;\n    position: absolute;\n\n    /* Alinhamento: altera o posicionamento aqui se quiser mover */\n    right: 24px;\n    /* Distância da borda direita da barra vermelha */\n    top: 50%;\n    transform: translateY(-50%);\n\n    /* Dimensões da imagem (ajustadas para caber perfeitamente na barra) */\n    width: 300px;\n    height: 75px;\n\n    /* Link da sua imagem do SENAI */\n    background-image: url(\"https://upload.wikimedia.org/wikipedia/commons/8/8c/SENAI_S%C3%A3o_Paulo_logo.png?utm_source=pt.wikipedia.org&utm_campaign=index&utm_content=original\");\n    background-size: contain;\n    background-repeat: no-repeat;\n    background-position: center;\n\n    /* Garante que fique visível sobre o fundo vermelho */\n    z-index: 99;\n}\n\n/* Altera o tamanho e o estilo do título no cabeçalho (ex: \"Page 1\") */\n.v-toolbar-title,\n.v-toolbar-title__placeholder {\n    font-size: 1.6rem !important; /* Aumente ou diminua aqui (ex: 1.8rem, 24px, etc) */\n    font-weight: bold !important;  /* Opcional: deixa o título em negrito */\n    letter-spacing: 0.5px;         /* Opcional: espaçamento sutil entre as letras */\n}",
