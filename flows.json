        "id": "1313c5c2a76b414e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "// Cria um array vazio para armazenar as mensagens de saída\nlet saidas = [];\n\n// Percorre as 8 primeiras posições do msg.payload (de 0 a 7)\nfor (let i = 0; i < 8; i++) {\n    // Adiciona o objeto de mensagem para cada saída. \n    // Se a posição não existir na entrada, envia 'undefined' ou um valor padrão.\n    saidas.push({ payload: msg.payload[i] });\n}\n\n// Retorna o array com as 8 saídas ordenadas (da saída 1 até a 8)\nreturn saidas;",
        "outputs": 8,
        "timeout": 0,
