    {
        "id": "tmpl_fila_pedidos",
        "type": "ui-template",
        "z": "f6f2187d.f17ca8",
        "group": "grp_fila_pedidos",
        "page": "",
        "ui": "",
        "name": "Fila & Rastreamento CLP",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div class=\"queue-container\">\n  <!-- Header de Monitoramento da Fila -->\n  <div class=\"queue-card-top\">\n    <div class=\"queue-meta\">\n      <span class=\"queue-count-label\">Ordens na Linha: <strong>{{ pedidos.length }}</strong></span>\n    </div>\n    <div class=\"clp-status-tag\">\n      <span class=\"status-indicator-dot online\"></span>\n      <span>Sincronizado via Modbus</span>\n    </div>\n  </div>\n\n  <!-- Lista de Pedidos -->\n  <div class=\"queue-items-list\">\n    <div \n      v-for=\"(pedido, index) in pedidos\" \n      :key=\"index\" \n      class=\"queue-item-card\">\n      \n      <div class=\"item-header-row\">\n        <div class=\"id-and-name\">\n          <span class=\"order-sequence\">#{{ String(index + 1).padStart(3, '0') }}</span>\n          <span class=\"order-name\">{{ pedido.nome }}</span>\n        </div>\n        <span class=\"type-pill\" :class=\"pedido.tipo.toLowerCase()\">{{ pedido.tipo }}</span>\n      </div>\n\n      <!-- Tag de Estado do CLP Sóbria -->\n      <div class=\"clp-state-container\">\n        <div class=\"clp-state-pill\" :class=\"getStateBadgeClass(pedido.estado)\">\n          <span class=\"state-dot\" :class=\"getStateDotClass(pedido.estado)\"></span>\n          <span class=\"state-text\">{{ pedido.estado }}</span>\n        </div>\n      </div>\n\n      <!-- Barra de Progresso Discreta -->\n      <div class=\"progress-container\">\n        <div class=\"progress-bar\" :style=\"{ width: getProgressPercent(pedido.estado) + '%' }\"></div>\n      </div>\n\n      <div class=\"item-footer-row\">\n        <span class=\"progress-percentage\">{{ getProgressPercent(pedido.estado) }}% concluído</span>\n        <span class=\"order-time\">{{ pedido.timestamp }}</span>\n      </div>\n    </div>\n\n    <!-- Estado Vazio -->\n    <div class=\"empty-list-notice\" v-if=\"pedidos.length === 0\">\n      <span>Nenhum pedido ativo na esteira no momento.</span>\n    </div>\n  </div>\n</div>\n\n<script>\nexport default {\n  data() {\n    return {\n      pedidos: [\n        {\n          nome: 'SENAI',\n          tipo: 'PADRAO',\n          estado: 'Centro: Usinando peça',\n          timestamp: '15:40:12'\n        },\n        {\n          nome: 'MARCELO',\n          tipo: 'PERSONALIZADO',\n          estado: 'Estoque 2 (Torneadas): Aguardando Centro de Usinagem',\n          timestamp: '15:42:05'\n        },\n        {\n          nome: 'RODRIGO',\n          tipo: 'PERSONALIZADO',\n          estado: 'Em espera na fila (Estoque 1 - Bruto)',\n          timestamp: '15:44:30'\n        }\n      ]\n    };\n  },\n  mounted() {\n    this.$socket?.on('ui-template:' + this.id, (msg) => {\n      if (msg && msg.payload) {\n        if (msg.payload.tipo && msg.payload.nome) {\n          this.pedidos.unshift(msg.payload);\n        } else if (msg.payload.ordemId !== undefined && msg.payload.novoEstado) {\n          const item = this.pedidos[msg.payload.ordemId];\n          if (item) item.estado = msg.payload.novoEstado;\n        }\n      }\n    });\n  },\n  methods: {\n    getProgressPercent(estado) {\n      const mapa = {\n        'Em espera na fila (Estoque 1 - Bruto)': 15,\n        'Torno: Torneando o primeiro lado': 30,\n        'Torno: Torneando o segundo lado': 45,\n        'Estoque 2 (Torneadas): Aguardando Centro de Usinagem': 60,\n        'Centro: Usinando peça': 75,\n        'Estoque 3 (Usinadas): Aguardando Centro para customizar a sua peça!': 85,\n        'Centro: Customizando sua peça': 92,\n        'Peça pronta': 100\n      };\n      return mapa[estado] || 10;\n    },\n    getStateBadgeClass(estado) {\n      if (estado === 'Peça pronta') return 'badge-success';\n      if (estado.includes('Centro') || estado.includes('Torno')) return 'badge-active';\n      return 'badge-waiting';\n    },\n    getStateDotClass(estado) {\n      if (estado === 'Peça pronta') return 'dot-success';\n      if (estado.includes('Centro') || estado.includes('Torno')) return 'dot-active';\n      return 'dot-waiting';\n    }\n  }\n};\n</script>\n\n<style>\n.queue-container {\n  font-family: var(--font-sans, system-ui, sans-serif);\n  color: #f8fafc;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.queue-card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  background: #1e293b;\n  border: 1px solid #334155;\n  border-radius: 8px;\n  padding: 12px 16px;\n}\n.queue-count-label {\n  font-size: 0.8rem;\n  color: #94a3b8;\n}\n.queue-count-label strong {\n  color: #f8fafc;\n}\n.clp-status-tag {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.75rem;\n  color: #10b981;\n}\n.status-indicator-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #10b981;\n}\n\n.queue-items-list {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  max-height: 480px;\n  overflow-y: auto;\n}\n.queue-item-card {\n  background: #1e293b;\n  border: 1px solid #334155;\n  border-radius: 8px;\n  padding: 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.item-header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.id-and-name {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.order-sequence {\n  font-size: 0.75rem;\n  font-weight: 600;\n  color: #64748b;\n  background: #0f172a;\n  padding: 2px 6px;\n  border-radius: 4px;\n  border: 1px solid #334155;\n}\n.order-name {\n  font-size: 0.92rem;\n  font-weight: 600;\n  color: #f8fafc;\n}\n.type-pill {\n  font-size: 0.7rem;\n  font-weight: 500;\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n.type-pill.padrao {\n  background: #0f172a;\n  color: #94a3b8;\n  border: 1px solid #334155;\n}\n.type-pill.personalizado {\n  background: rgba(37, 99, 235, 0.12);\n  color: #60a5fa;\n  border: 1px solid rgba(37, 99, 235, 0.3);\n}\n\n.clp-state-container {\n  display: flex;\n}\n.clp-state-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  border-radius: 6px;\n  font-size: 0.75rem;\n}\n.clp-state-pill.badge-active {\n  background: rgba(37, 99, 235, 0.12);\n  border: 1px solid rgba(37, 99, 235, 0.3);\n  color: #93c5fd;\n}\n.clp-state-pill.badge-waiting {\n  background: rgba(245, 158, 11, 0.12);\n  border: 1px solid rgba(245, 158, 11, 0.3);\n  color: #fcd34d;\n}\n.clp-state-pill.badge-success {\n  background: rgba(16, 185, 129, 0.12);\n  border: 1px solid rgba(16, 185, 129, 0.3);\n  color: #6ee7b7;\n}\n\n.state-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n}\n.dot-active { background: #3b82f6; }\n.dot-waiting { background: #f59e0b; }\n.dot-success { background: #10b981; }\n\n.progress-container {\n  height: 4px;\n  background: #0f172a;\n  border-radius: 9999px;\n  overflow: hidden;\n}\n.progress-bar {\n  height: 100%;\n  background: #2563eb;\n  border-radius: 9999px;\n  transition: width 0.3s ease;\n}\n\n.item-footer-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.72rem;\n  color: #64748b;\n}\n\n.empty-list-notice {\n  text-align: center;\n  padding: 30px;\n  color: #64748b;\n  font-size: 0.8rem;\n}\n</style>",
