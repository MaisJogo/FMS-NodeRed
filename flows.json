    {
        "id": "tmpl_sinotico_topdown",
        "type": "ui-template",
        "z": "f6f2187d.f17ca8",
        "group": "grp_sinotico_topdown",
        "page": "",
        "ui": "",
        "name": "Sinótico Top-Down Célula FMS",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div class=\"scada-root\">\n  <!-- Top Bar com Identidade SENAI SP -->\n  <div class=\"scada-top-bar\">\n    <div class=\"scada-brand-row\">\n      \n      <div>\n        <h2 class=\"scada-main-title\">Célula Integrada de Manufatura de Chaveiros</h2>\n        <p class=\"scada-sub-title\">Visualização da integração em tempo real</p>\n      </div>\n    </div>\n    <div class=\"scada-quick-indicators\">\n      <div class=\"indicator-item\">\n        <span class=\"status-dot green\"></span>\n        <span>CLP Altus: Conectado</span>\n      </div>\n      <div class=\"indicator-item\">\n        <span class=\"status-dot green\"></span>\n        <span>Ciclo: Automático</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Grid Principal da Célula -->\n  <div class=\"cell-main-grid\">\n    \n    <!-- 1. ESQUERDA: CENTRO DE USINAGEM -->\n    <div class=\"station-elevation-card\">\n      <div class=\"station-title-row\">\n        <h3 class=\"station-headline\">Centro de Usinagem</h3>\n        <span class=\"status-pill green\">Operante</span>\n      </div>\n\n      <!-- Imagem Hero do Centro de Usinagem -->\n      <div class=\"machine-hero-container\">\n        <div class=\"image-tint-wrapper\" :class=\"{ 'is-processing': centroAtivo }\">\n          <img src=\"/Centro.png\" alt=\"Centro de Usinagem\" class=\"machine-photo\" />\n        </div>\n      </div>\n\n      <div class=\"station-info-metrics\">\n        <div class=\"info-row\">\n          <span class=\"info-label\">Operação</span>\n          <span class=\"info-val\">Gravação / Acabamento</span>\n        </div>\n        <div class=\"info-row\">\n          <span class=\"info-label\">Estado</span>\n          <span class=\"info-val text-emerald\">Pronto para operação</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 2. CENTRO: RAMPAS (TOPO) + ROBÔ HERO (BASE) -->\n    <div class=\"center-elevation-flow\">\n      \n      <!-- RAMPAS DE ALIMENTAÇÃO -->\n      <div class=\"station-elevation-card\">\n        <div class=\"station-title-row\">\n          <h3 class=\"station-headline\">Rampas de Alimentação</h3>\n        </div>\n\n        <div class=\"ramps-grid-clean\">\n          <!-- Estoque 1 -->\n          <div class=\"ramp-chute-clean\">\n            <div class=\"ramp-top-meta\">\n              <span class=\"ramp-title\">Estoque 1</span>\n              <span class=\"ramp-type-tag\">Entrada</span>\n            </div>\n            <div class=\"roller-strip\">\n              <span class=\"roller-bar\"></span>\n              <span class=\"roller-bar\"></span>\n              <span class=\"roller-bar\"></span>\n            </div>\n            <span class=\"ramp-material-desc\">Alumínio Bruto</span>\n            <div class=\"ramp-status-tag ready\">Disponível</div>\n          </div>\n\n          <!-- Estoque 2 -->\n          <div class=\"ramp-chute-clean\">\n            <div class=\"ramp-top-meta\">\n              <span class=\"ramp-title\">Estoque 2</span>\n              <span class=\"ramp-type-tag\">Buffer</span>\n            </div>\n            <div class=\"roller-strip\">\n              <span class=\"roller-bar\"></span>\n              <span class=\"roller-bar\"></span>\n              <span class=\"roller-bar\"></span>\n            </div>\n            <span class=\"ramp-material-desc\">Peças Torneadas</span>\n            <div class=\"ramp-status-tag wait\">Aguardando Centro</div>\n          </div>\n\n          <!-- Estoque 3 -->\n          <div class=\"ramp-chute-clean\">\n            <div class=\"ramp-top-meta\">\n              <span class=\"ramp-title\">Estoque 3</span>\n              <span class=\"ramp-type-tag\">Saída</span>\n            </div>\n            <div class=\"roller-strip\">\n              <span class=\"roller-bar\"></span>\n              <span class=\"roller-bar\"></span>\n              <span class=\"roller-bar\"></span>\n            </div>\n            <span class=\"ramp-material-desc\">Peças Usinadas</span>\n            <div class=\"ramp-status-tag done\">Prontas</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- ROBÔ MANIPULADOR (IMAGEM HERO EM DESTAQUE) -->\n      <div class=\"station-elevation-card\">\n        <div class=\"station-title-row\">\n          <h3 class=\"station-headline\">Robô Manipulador</h3>\n          <span class=\"status-pill green\">Operante</span>\n        </div>\n\n        <div class=\"robot-hero-container\">\n          <div class=\"image-tint-wrapper\" :class=\"{ 'is-processing': roboAtivo }\">\n            <img src=\"/robo.png\" alt=\"Robô Manipulador\" class=\"robot-photo\" />\n          </div>\n          <!-- Trilho Físico Discreto -->\n          <div class=\"rail-track-line\"></div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- 3. DIREITA: TORNO CNC (IMAGEM HERO EM DESTAQUE) -->\n    <div class=\"station-elevation-card\">\n      <div class=\"station-title-row\">\n        <h3 class=\"station-headline\">Torno CNC</h3>\n        <span class=\"status-pill\" :class=\"tornoAtivo ? 'processing' : 'green'\">\n          {{ tornoStatusBadge }}\n        </span>\n      </div>\n\n      <!-- Imagem Hero do Torno CNC com Efeito Verde Suave quando em Processamento -->\n      <div class=\"machine-hero-container\">\n        <div class=\"image-tint-wrapper\" :class=\"{ 'is-processing': tornoAtivo }\">\n          <img src=\"/Torno.png\" alt=\"Torno CNC\" class=\"machine-photo\" />\n        </div>\n      </div>\n\n      <div class=\"station-info-metrics\">\n        <div class=\"info-row\">\n          <span class=\"info-label\">Operação</span>\n          <span class=\"info-val\" :class=\"{ 'text-emerald': tornoAtivo }\">\n            {{ tornoAtivo ? 'Torneamento Lado 1 (Em Curso)' : 'Usinagem Lado 1 / Lado 2' }}\n          </span>\n        </div>\n        <div class=\"info-row\">\n          <span class=\"info-label\">Estado</span>\n          <span class=\"info-val\" :class=\"tornoAtivo ? 'text-emerald' : 'text-emerald'\">\n            {{ tornoAtivo ? '● Processando Peça' : 'Pronto para operação' }}\n          </span>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\nexport default {\n  data() {\n    return {\n      tornoAtivo: false,\n      tornoStatusBadge: 'Operante',\n      centroAtivo: false,\n      roboAtivo: false\n    };\n  },\n  watch: {\n    msg: {\n      immediate: true,\n      handler(newVal) {\n        if (!newVal || !newVal.payload) return;\n        const p = newVal.payload;\n        if (p.estacao === 'torno' || newVal.topic === 'simulacao_torno') {\n          this.tornoAtivo = !!p.operando;\n          this.tornoStatusBadge = this.tornoAtivo ? 'Torneando L1' : 'Operante';\n        }\n      }\n    }\n  },\n  mounted() {\n    this.$socket?.on('ui-template:' + this.id, (msg) => {\n      if (msg && msg.payload && (msg.payload.estacao === 'torno' || msg.topic === 'simulacao_torno')) {\n        this.tornoAtivo = !!msg.payload.operando;\n        this.tornoStatusBadge = this.tornoAtivo ? 'Torneando L1' : 'Operante';\n      }\n    });\n  }\n};\n</script>\n\n<style>\n.scada-root {\n  font-family: var(--font-sans, system-ui, sans-serif);\n  color: #f8fafc;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n/* Header com Toque SENAI SP */\n.scada-top-bar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 4px 6px;\n}\n.scada-brand-row {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n.senai-sp-badge {\n  background: #e30613;\n  color: #ffffff;\n  font-weight: 700;\n  font-size: 0.85rem;\n  letter-spacing: 0.08em;\n  padding: 6px 14px;\n  border-radius: 6px;\n  display: inline-flex;\n  align-items: center;\n  box-shadow: 0 2px 8px rgba(227, 6, 19, 0.35);\n}\n.scada-main-title {\n  font-size: 1.25rem;\n  font-weight: 600;\n  color: #ffffff;\n  margin: 0;\n  letter-spacing: -0.01em;\n}\n.scada-sub-title {\n  font-size: 0.82rem;\n  color: #94a3b8;\n  margin: 2px 0 0 0;\n}\n.scada-quick-indicators {\n  display: flex;\n  gap: 16px;\n}\n.indicator-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 0.8rem;\n  color: #cbd5e1;\n}\n.status-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n}\n.status-dot.green { background: #10b981; }\n\n/* Grid Principal da Célula */\n.cell-main-grid {\n  display: grid;\n  grid-template-columns: 310px 1fr 310px;\n  gap: 20px;\n}\n@media (max-width: 1024px) {\n  .cell-main-grid { grid-template-columns: 1fr; }\n}\n\n/* Cards com Separação por Elevation (Sem bordas pesadas) */\n.station-elevation-card {\n  background: #1e293b;\n  border-radius: 12px;\n  padding: 22px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);\n  transition: background-color 0.25s ease, box-shadow 0.25s ease;\n}\n\n/* Títulos sem Linha Divisória */\n.station-title-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.station-headline {\n  font-size: 1.15rem;\n  font-weight: 600;\n  color: #ffffff;\n  margin: 0;\n  letter-spacing: -0.01em;\n}\n\n/* Badges de Status */\n.status-pill {\n  font-size: 0.75rem;\n  font-weight: 500;\n  padding: 4px 10px;\n  border-radius: 6px;\n}\n.status-pill.green {\n  background: rgba(16, 185, 129, 0.12);\n  color: #10b981;\n}\n.status-pill.processing {\n  background: rgba(16, 185, 129, 0.2);\n  color: #10b981;\n  font-weight: 600;\n  animation: pulse-soft 2s infinite ease-in-out;\n}\n@keyframes pulse-soft {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.7; }\n}\n\n/* HERO IMAGES: As fotos do Torno, Centro e Robô em Destaque */\n.machine-hero-container {\n  background: #141d2e;\n  border-radius: 10px;\n  height: 220px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  position: relative;\n  overflow: hidden;\n}\n.robot-hero-container {\n  background: #141d2e;\n  border-radius: 10px;\n  height: 180px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  position: relative;\n}\n\n/* Efeito Verde Suave por Cima da Imagem quando em Processamento */\n.image-tint-wrapper {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  transition: all 0.3s ease;\n}\n.image-tint-wrapper::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle, rgba(16, 185, 129, 0.25) 0%, rgba(16, 185, 129, 0.08) 60%, transparent 85%);\n  pointer-events: none;\n  border-radius: 8px;\n  opacity: 0;\n  transition: opacity 0.35s ease;\n}\n.image-tint-wrapper.is-processing::after {\n  opacity: 1;\n}\n.image-tint-wrapper.is-processing .machine-photo,\n.image-tint-wrapper.is-processing .robot-photo {\n  filter: drop-shadow(0 0 14px rgba(16, 185, 129, 0.55)) brightness(1.05);\n}\n\n.machine-photo {\n  max-width: 110%;\n  max-height: 110%;\n  object-fit: contain;\n  transition: filter 0.3s ease, transform 0.3s ease;\n}\n.robot-photo {\n  max-width: 100%;\n  max-height: 130px;\n  object-fit: contain;\n  transition: filter 0.3s ease;\n  position: relative;\n  z-index: 2;\n}\n\n/* Trilho Físico Discreto do Robô */\n.rail-track-line {\n  position: absolute;\n  bottom: 22px;\n  left: 20px;\n  right: 20px;\n  height: 3px;\n  background: #25334a;\n  border-radius: 2px;\n}\n\n/* Métricas de Informação */\n.station-info-metrics {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding-top: 4px;\n}\n.info-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.78rem;\n}\n.info-label { color: #94a3b8; }\n.info-val { font-weight: 500; color: #cbd5e1; }\n.text-emerald { color: #10b981; }\n\n/* Coluna Central */\n.center-elevation-flow {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n/* Rampas Limpas */\n.ramps-grid-clean {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 12px;\n}\n.ramp-chute-clean {\n  background: #141d2e;\n  border-radius: 8px;\n  padding: 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.ramp-top-meta {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.ramp-title {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #ffffff;\n}\n.ramp-type-tag {\n  font-size: 0.68rem;\n  color: #94a3b8;\n}\n.roller-strip {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  padding: 8px 0;\n}\n.roller-bar {\n  height: 3px;\n  background: #25334a;\n  border-radius: 2px;\n}\n.ramp-material-desc {\n  font-size: 0.75rem;\n  color: #94a3b8;\n  min-height: 22px;\n}\n.ramp-status-tag {\n  font-size: 0.72rem;\n  font-weight: 500;\n  padding: 4px 6px;\n  border-radius: 4px;\n  text-align: center;\n}\n.ramp-status-tag.ready { background: rgba(37, 99, 235, 0.12); color: #60a5fa; }\n.ramp-status-tag.wait { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }\n.ramp-status-tag.done { background: rgba(16, 185, 129, 0.12); color: #10b981; }\n</style>",
