    {
        "id": "func_processamento_torno",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Processamento",
        "func": "// Processamento da Entrada Simulada Manual do Torno CNC\n// Entrada esperada: msg.payload booleana (true = peça sendo torneada, false = parado)\n\nconst operando = msg.payload === true;\n\n// 1. Mensagem para o Sinótico da Célula Top-Down (atualiza o Torno visualmente)\nconst msgSinotico = {\n    topic: \"simulacao_torno\",\n    payload: {\n        estacao: \"torno\",\n        operando: operando,\n        status: operando ? \"Torneando o primeiro lado\" : \"Pronto para operação\",\n        tagCLP: operando ? \"Torno: Torneando o primeiro lado\" : \"Pronto para operação\",\n        pecaPresente: operando,\n        timestamp: new Date().toLocaleTimeString()\n    }\n};\n\n// 2. Mensagem para a Fila de Produção (atualiza a ordem ativa)\nconst msgFila = {\n    payload: {\n        ordemId: 0,\n        novoEstado: operando ? \"Torno: Torneando o primeiro lado\" : \"Torno: Torneando o segundo lado\"\n    }\n};\n\n// Envia para o nó do Sinótico (saída 1) e para a Fila (saída 2)\nreturn [msgSinotico, msgFila];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
