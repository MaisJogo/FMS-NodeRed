        "head": "",
        "format": "/* Remove a borda e o fundo escuro do grupo específico da imagem */\n#nrdb-ui-group-a61d6065215da822 .v-card.bg-group-background {\n    background-color: transparent !important;\n    background: transparent !important;\n    border: none !important;\n    box-shadow: none !important;\n}\n\n/* Remove margens e espaçamentos internos para que o logo respire */\n#nrdb-ui-group-a61d6065215da822 .v-card-text {\n    padding: 0 !important;\n}\n\n/* Esconde o título do grupo onde está o logotipo */\n#nrdb-ui-group-a61d6065215da822 .v-card-title {\n    display: none !important;\n}",
